# 실제 볼트의 .gitattributes 그대로다. 이 저장소에는 대응하는 실제 파일이 없고
# `.example` 자리표시자만 있으므로 어떤 규칙도 실제로 적용되지 않는다.
# 새 시크릿을 볼트에 추가할 때 가장 먼저 손대야 하는 파일이라 원문을 남겨 둔다.
api.env                     filter=git-crypt diff=git-crypt
proxmox-token.json          filter=git-crypt diff=git-crypt
lightsail-ssh.pem           filter=git-crypt diff=git-crypt
sshgw-ssh_host_ed25519_key  filter=git-crypt diff=git-crypt
origin-ca/origin.key        filter=git-crypt diff=git-crypt
sshgw-upstream_ed25519_key  filter=git-crypt diff=git-crypt
sshgw-terminal_ed25519_key  filter=git-crypt diff=git-crypt
