# pickle-llm-gateway 런타임 env — 예시본
#
# 실제 볼트의 llm-gateway.env는 이 키 구성 그대로이되 값이 채워져 있고,
# git-crypt로 암호화되어 커밋된다. 이 파일의 값은 전부 자리표시자다.
#
# 배포 대상: LXC 103 /etc/pickle/llm-gateway.env (모드 640, root:pickle-llmgw)
# 데몬은 업스트림 키가 없으면 기동을 거부한다(fail-closed).

# --- 주소와 경로 ---
# 게이트웨이는 리버스 프록시 컨테이너에서만 닿는 내부 주소에 바인딩한다.
LLMGW_LISTEN=<컨테이너 내부 주소>:8081
LLMGW_SNAPSHOT_PATH=/var/lib/pickle-llm-gateway/snapshot.json
LLMGW_SPOOL_DIR=/var/lib/pickle-llm-gateway/spool

# --- 업스트림 ---
# 블록 이름(<REF>)은 스냅샷 문서의 upstreamRef가 고르는 이름이다. 여러 블록을
# 두면 모델별로 다른 업스트림을 가리킬 수 있다.
LLMGW_UPSTREAM_<REF>_BASE_URL=https://<업스트림 호스트>/v1
LLMGW_UPSTREAM_<REF>_API_KEY=<업스트림 발급 키>
# 상한 주입 필드는 업스트림이 무엇을 받는지에 따라 다르다. 기본값은
# max_completion_tokens이고, 구 필드만 받는 서버에는 max_tokens를 적는다.
#LLMGW_UPSTREAM_<REF>_CAP_FIELD=max_tokens

# --- 관리 API 연계(선택) ---
# 셋 다 기본값이 꺼짐이다. 관리 API가 이 경로들을 서비스하기 전에 켜면
# 동기화는 실패하고 사용량 전송은 재시도만 반복한다.
#LLMGW_SNAPSHOT_SOURCE=http
#LLMGW_CONTROL_BASE_URL=https://<관리 API 내부 주소>
#LLMGW_CONTROL_TOKEN=<관리 API와 나눠 갖는 고정 토큰>
#LLMGW_USAGE_PUSH=on
#LLMGW_BODY_CAPTURE=on

# --- 운영 지표(선택) ---
# 지정하면 그 주소에서만 /metrics와 /healthz를 연다. 학생이 접속하는 주소에는
# 이 경로가 없다. 루프백이나 내부 대역에만 둘 것.
#LLMGW_ADMIN_LISTEN=127.0.0.1:8082
